{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Aoe Debug (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Debug/debug/newAOE.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "D:\\QT5\\Tools\\mingw530_32\\bin;D:\\QT5\\5.9.2\\mingw53_32\\bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/QT5/Tools/mingw530_32/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "qmake: build Debug"
        },

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "qmake: build Debug",
            "type": "process",
            "command": "${workspaceFolder}/.vscode/build-debug-qmake.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared", "showReuseMessage": false }
        },
        {
            "label": "qmake: build Release",
            "type": "process",
            "command": "${workspaceFolder}/.vscode/build-release-qmake.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared", "showReuseMessage": false }
        },
        {
            "label": "qmake: clean Debug",
            "type": "process",
            "command": "cmd",
            "args": ["/c", "if exist Debug rmdir /s /q Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "shared", "showReuseMessage": false }
        },
        {
            "label": "qmake: clean Build",
            "type": "process",
            "command": "cmd",
            "args": ["/c", "if exist Build rmdir /s /q Build"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "shared", "showReuseMessage": false }
        }
    ]
}
